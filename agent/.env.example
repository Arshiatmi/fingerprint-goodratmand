# "mock" = fake fingerprints (development). "biomini" = real Suprema scanner via BioMiniWebAgent.
AGENT_MODE=biomini

# Where BioMiniWebAgent.exe listens (from its BiominiWebAgent.js: https on port 8083).
BIOMINI_HOST=127.0.0.1
BIOMINI_PORT=8083

# Template quality threshold sent to the agent. 6 = quality 40 (the demo's default).
# Higher = stricter (1 none, 2=0, 3=10, 4=20, 5=30, 6=40, 7=50, 8=60, 9=70, 10=80, 11=90).
BIOMINI_QUALITY_LEVEL=6

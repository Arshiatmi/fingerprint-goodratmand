# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# 32-byte key as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every stored fingerprint unreadable. Back it up.
FP_ENC_KEY=

# "mock" compares templates byte-for-byte (development only).
# "agent" asks the local Suprema agent to match templates (real use).
MATCHER=mock
AGENT_URL=http://localhost:8443

# Set to false when the real scanner is connected: the API then refuses test (MOCK) fingerprints.
ALLOW_MOCK_SCANNER=true

PORT=3000
